# Configure on the server only. Never use a NEXT_PUBLIC_ prefix for this key.
OPENAI_API_KEY=

# OpenAI-compatible HTTPS endpoint including /v1.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Use browser when the provider has no transcription model.
SPEECH_MODE=provider

# Cost estimate assumptions used in session evidence. Override these with the
# rates from your provider account or invoice. Defaults benchmark the configured
# intermediary at 7% of public GPT-5.4 token rates.
AI_INPUT_USD_PER_MILLION=0.175
AI_CACHED_INPUT_USD_PER_MILLION=0.0175
AI_OUTPUT_USD_PER_MILLION=1.05
AI_AUDIO_USD_PER_MINUTE=0.003
AI_PRICING_DATE=2026-09-22
