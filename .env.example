# Configure on the server only. Never use a NEXT_PUBLIC_ prefix for this key.
OPENAI_API_KEY=

# OpenAI-compatible HTTPS endpoint including /v1.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini-2025-04-14
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Use browser when the provider has no transcription model.
SPEECH_MODE=provider
